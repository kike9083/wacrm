# Appwrite (Configuración del Cliente)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://varios-appwrite-techpadah.fjueze.easypanel.host/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6a65b6900038f0345d67
NEXT_PUBLIC_APPWRITE_DATABASE_ID=6a65bc1cf1155569e283

# Appwrite (Configuración del Servidor)
APPWRITE_API_KEY=your_appwrite_api_key

# Site URL (requerido para OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Driver (meta | evolution)
WHATSAPP_DRIVER=meta

# Evolution API (solo si WHATSAPP_DRIVER=evolution)
EVOLUTION_API_URL=https://evolution-tu-dominio.easypanel.host
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE_NAME=default

# WhatsApp Meta Cloud API (solo si WHATSAPP_DRIVER=meta)
ENCRYPTION_KEY=your_64_char_hex_encryption_key
META_APP_SECRET=your_meta_app_secret
